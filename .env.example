# Copier ce fichier en .env puis remplir les valeurs. Le fichier .env est ignoré par git : n'y mettez
# jamais de vraies valeurs dans .env.example. Il est chargé automatiquement par `python -m blablacook`.

# --- Serveur ---
BLABLACOOK_PORT=8000
# URL publique utilisée dans les liens des mails (par défaut : l'adresse de la requête).
# BLABLACOOK_BASE_URL=https://blablacook.example.org

# --- Domaines étudiants ---
# Domaines ajoutés à la liste blablacook/data/student_domains.txt (séparés par des virgules).
# Les domaines .test servent aux comptes de démonstration.
BLABLACOOK_DOMAINS=campus.test,etudiants.test

# --- Envoi des mails de confirmation (SMTP) ---
# Sans BLABLACOOK_SMTP_HOST, les mails sont affichés dans le terminal du serveur (mode développement).
BLABLACOOK_SMTP_HOST=
BLABLACOOK_SMTP_PORT=587
# starttls (port 587), ssl (port 465) ou none
BLABLACOOK_SMTP_SECURITY=starttls
BLABLACOOK_SMTP_USER=
BLABLACOOK_SMTP_PASSWORD=
BLABLACOOK_MAIL_FROM=BlablaCook <no-reply@exemple.fr>

# --- Google Maps (carte et autocomplétion d'adresse) ---
# Clé navigateur : activer « Maps JavaScript API » et « Places API (New) » dans la console Google Cloud,
# et restreindre la clé aux référents HTTP du site (ex. http://127.0.0.1:8000/*).
GOOGLE_MAPS_API_KEY=

# --- Photos automatiques des repas (Openverse, aucune clé nécessaire) ---
# Photos sous licence Creative Commons trouvées d'après le titre du repas. Si rien n'est trouvé, l'image par
# défaut est utilisée. Mettre « off » pour ne jamais appeler le service (fonctionnement hors ligne).
BLABLACOOK_IMAGE_SEARCH=on

# --- Brise-glace par IA (LLM gratuit, facultatif) ---
# Sans clé, les questions brise-glace viennent des règles intégrées. Avec une clé, un LLM propose des questions
# à partir des seules informations PUBLIQUES du repas (jamais allergies, régime, adresse ni email).
# Groq (gratuit, sans carte bancaire) : créer une clé sur https://console.groq.com/keys
BLABLACOOK_LLM_KEY=
# Valeurs par défaut (Groq) ; à décommenter pour un autre fournisseur compatible OpenAI :
# BLABLACOOK_LLM_URL=https://api.groq.com/openai/v1/chat/completions
# BLABLACOOK_LLM_MODEL=openai/gpt-oss-120b
# Google Gemini (clé sur https://aistudio.google.com/apikey) :
# BLABLACOOK_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# BLABLACOOK_LLM_MODEL=gemini-2.5-flash
# Mistral (clé sur https://console.mistral.ai) :
# BLABLACOOK_LLM_URL=https://api.mistral.ai/v1/chat/completions
# BLABLACOOK_LLM_MODEL=mistral-small-latest
